# vps_init.conf — настройки vps_init.sh
#
# Скопируйте этот файл:   cp vps_init.conf.example vps_init.conf
# и отредактируйте под конкретный сервер. Файл — обычный bash: КЛЮЧ=значение, массивы в ( ).
# Всё, что не задано здесь, берёт значения по умолчанию из vps_init.sh.
# Флаги командной строки (--user, --profile, --only, --skip) важнее этого файла.

# --- Профиль ----------------------------------------------------------------
# server  — VPS: всё, включая защиту SSH и firewall.
# desktop — локальная/рабочая машина: модули ssh и firewall пропускаются.
PROFILE="server"

# --- Пользователь -------------------------------------------------------------
# Имя пользователя, которого создаст скрипт (sudo с паролем, группа docker).
# Пароль запрашивается интерактивно при запуске и в лог не попадает.
USERNAME="aleksey"

# Скопировать новому пользователю ключи из /root/.ssh/authorized_keys
# (туда их кладёт хостинг, если ключ указан при создании сервера).
COPY_ROOT_KEYS=true

# Дополнительные публичные ключи (содержимое ~/.ssh/id_ed25519.pub на вашем компьютере).
SSH_PUBLIC_KEYS=(
  # "ssh-ed25519 AAAAC3Nza... aleksey@laptop"
)

# --- Система ------------------------------------------------------------------
# Обновить все установленные пакеты (apt upgrade). На свежем сервере — обязательно.
APT_UPGRADE=true

TIMEZONE="Europe/Moscow"     # список: timedatectl list-timezones
NEW_HOSTNAME=""              # пусто — не менять имя хоста; например "web1"

# Автоматическая установка обновлений безопасности (unattended-upgrades).
# false — скрипт их не трогает (на Ubuntu они обычно уже включены системой),
# true  — установить и включить (полезно на Debian, где их нет по умолчанию).
ENABLE_AUTO_UPGRADES=false

# Swap-файл (полезно на VPS с 1–2 ГБ RAM). Не создаётся, если swap уже есть.
ENABLE_SWAP=false
SWAP_SIZE="2G"

# --- SSH (только профиль server) ---------------------------------------------
# Применяются только если у пользователя USERNAME есть хотя бы один SSH-ключ,
# иначе скрипт откажется, чтобы вы не потеряли доступ к серверу.
SSH_DISABLE_ROOT_LOGIN=true
SSH_DISABLE_PASSWORD_AUTH=true

# --- Firewall (только профиль server) ----------------------------------------
# SSH (22) открыт всегда. 80/443 — для веб-приложений.
UFW_ALLOW_HTTP=true
# Дополнительные порты: "8080/tcp", "51820/udp", "3000"
UFW_EXTRA_PORTS=()
ENABLE_FAIL2BAN=true

# --- Git ----------------------------------------------------------------------
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# --- Docker -------------------------------------------------------------------
# Ротация логов контейнеров: до DOCKER_LOG_MAX_FILE файлов по DOCKER_LOG_MAX_SIZE.
DOCKER_LOG_MAX_SIZE="10m"
DOCKER_LOG_MAX_FILE=3
# Как часто чистить неиспользуемые образы и build-кэш (формат systemd OnCalendar).
DOCKER_PRUNE_SCHEDULE="weekly"

# --- Выбор модулей ------------------------------------------------------------
# Список модулей: ./vps_init.sh --list. Имена полные (70_docker) или короткие (docker).
MODULES_SKIP=()
